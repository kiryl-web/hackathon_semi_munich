index 4275c03..f7b5261 100644
--- a/proj_cm33_ns/router/spdm_router.c
+++ b/proj_cm33_ns/router/spdm_router.c
@@ -58,6 +58,96 @@
 #include "spdm_responder.h"
 #include "log/log.h"
 
+#include <string.h>
+#include <unistd.h>
+#include "spdm_perf_ns.h"
+#include "nsc_perf.h"
+
+/******************************************************************************
+ * Hackathon measurement ([PERF] lines on the debug UART)
+ *
+ * One line per SPDM transfer (= one DFU transaction = at most 127 B of SPDM):
+ *   n       transfer number since the last GET_VERSION (connection start)
+ *   req/rsp MCTP type 05 = plain SPDM -> SPDM request/response code;
+ *           MCTP type 06 = secured message (code is encrypted, shown as SEC)
+ *   rq/rs   request / response bytes on the wire (incl. 1-byte MCTP header)
+ *   large   total size of a chunked (fragmented) SPDM message, first chunk only
+ *   t       device time for this dispatch (libspdm + crypto), microseconds
+ *   sign/kexg/kexs/kem  secure-side crypto time inside this dispatch, us
+ *   cum_t/cum_b  running device time / wire bytes since GET_VERSION
+ *   nsstk/nsheap/sstk/sheap  peak NS stack, NS heap, S stack, S heap (bytes)
+ *****************************************************************************/
+spdm_perf_crypto_t g_spdm_perf;
+
+extern uint32_t __StackLimit;   /* NS stack bottom (linker_ns_flash.ld) */
+extern uint32_t __StackTop;
+extern char     __HeapBase;
+
+static volatile uint32_t s_perf_wraps;
+
+void SysTick_Handler(void)
+{
+    s_perf_wraps++;
+}
+
+void perf_ns_timer_init(void)
+{
+    SysTick->LOAD = 0x00FFFFFFUL;
+    SysTick->VAL  = 0U;
+    SysTick->CTRL = SysTick_CTRL_CLKSOURCE_Msk | SysTick_CTRL_TICKINT_Msk |
+                    SysTick_CTRL_ENABLE_Msk;
+}
+
+uint32_t perf_ns_cyc(void)
+{
+    uint32_t w1;
+    uint32_t w2;
+    uint32_t v;
+    bool     pend;
+    do {
+        w1   = s_perf_wraps;
+        v    = SysTick->VAL;
+        pend = ((SCB->ICSR & SCB_ICSR_PENDSTSET_Msk) != 0U);
+        w2   = s_perf_wraps;
+    } while (w1 != w2);
+    /* Counter reloaded (VAL jumped back up) but the wrap interrupt has not
+     * been serviced yet: count that wrap now. */
+    if (pend && (v > 0x00800000UL)) {
+        w1++;
+    }
+    return (w1 << 24) + (0x00FFFFFFUL - v);
+}
+
+static uint32_t s_perf_n;
+static uint32_t s_perf_cum_cyc;
+static uint32_t s_perf_cum_bytes;
+
+static uint32_t perf_large_size(const uint8_t *m, size_t len, uint8_t chunk_code)
+{
+    /* m[0] = MCTP type, m[1..] = SPDM. First chunk: seq (bytes 4..7 of the
+     * SPDM header) == 0 and LargeMessageSize at SPDM offset 12. */
+    if ((len >= 17U) && (m[0] == 0x05U) && (m[2] == chunk_code) &&
+        (m[5] == 0U) && (m[6] == 0U) && (m[7] == 0U) && (m[8] == 0U)) {
+        return (uint32_t)m[13] | ((uint32_t)m[14] << 8) |
+               ((uint32_t)m[15] << 16) | ((uint32_t)m[16] << 24);
+    }
+    return 0U;
+}
+
+static void perf_code_str(const uint8_t *m, size_t len, char out[4])
+{
+    static const char hex[] = "0123456789ABCDEF";
+    if ((len >= 3U) && (m[0] == 0x05U)) {
