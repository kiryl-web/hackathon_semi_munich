new file mode 100644
index 0000000..adf16c0
--- /dev/null
+++ b/shared/nsc_perf.h
@@ -0,0 +1,20 @@
+/******************************************************************************
+ * File Name:   nsc_perf.h
+ *
+ * Description: Hackathon measurement veneer: lets the NS world read secure
+ *              memory high-water marks. Scalar in / scalar out, no pointers
+ *              cross the boundary, so there is nothing to validate.
+ *****************************************************************************/
+#ifndef NSC_PERF_H
+#define NSC_PERF_H
+
+#include <stdint.h>
+
+#define NSC_PERF_S_HEAP_PEAK    (0U)  /* bytes of secure heap ever used       */
+#define NSC_PERF_S_HEAP_SIZE    (1U)  /* total secure heap size               */
+#define NSC_PERF_S_STACK_PEAK   (2U)  /* bytes of secure stack ever used      */
+#define NSC_PERF_S_STACK_SIZE   (3U)  /* total secure stack size              */
+
+uint32_t nsc_perf_get(uint32_t which);
+
+#endif /* NSC_PERF_H */
diff --git a/shared/spdm_perf.h b/shared/spdm_perf.h
new file mode 100644
index 0000000..a3e2a5d
--- /dev/null
+++ b/shared/spdm_perf.h
@@ -0,0 +1,65 @@
+/******************************************************************************
+ * File Name:   spdm_perf.h
+ *
+ * Description: Hackathon Task 1/3 measurement helpers (header-only, used by
+ *              both the secure and the non-secure project).
+ *
+ *              - DWT cycle counter: enabled once by the secure image before
+ *                the NS world starts (perf_cyccnt_enable()); both worlds read
+ *                DWT->CYCCNT. Convert with perf_cyc_to_us().
+ *              - Stack high-water mark: perf_stack_paint() fills the unused
+ *                part of the current stack with a pattern; perf_stack_unused()
+ *                counts how many bytes from the bottom were never touched.
+ *
+ *              Measurement only: no effect on the SPDM protocol or crypto.
+ *****************************************************************************/
+#ifndef SPDM_PERF_H
+#define SPDM_PERF_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include "cy_pdl.h"
+
+#define PERF_STACK_FILL   (0xA5A5A5A5UL)
+
+/* Secure image only: start the free-running core cycle counter. */
+static inline void perf_cyccnt_enable(void)
+{
+    DCB->DEMCR  |= DCB_DEMCR_TRCENA_Msk;
+    DWT->CYCCNT  = 0U;
+    DWT->CTRL   |= DWT_CTRL_CYCCNTENA_Msk;
+}
+
+static inline uint32_t perf_cyc(void)
+{
+    return DWT->CYCCNT;
+}
+
+static inline uint32_t perf_cyc_to_us(uint32_t cycles)
+{
+    uint32_t mhz = SystemCoreClock / 1000000UL;
+    return (mhz != 0U) ? (cycles / mhz) : cycles;
+}
+
+/* Fill [limit, current SP - margin) with the fill pattern. Call early, from
+ * the function whose stack should be measured (main). */
+static inline void perf_stack_paint(uint32_t *limit)
+{
+    uint32_t *sp = (uint32_t *)__get_MSP();
+    uint32_t *p;
+    for (p = limit; p < (sp - 16); p++) {
+        *p = PERF_STACK_FILL;
+    }
+}
+
+/* Bytes at the bottom of the stack that were never written since painting. */
+static inline uint32_t perf_stack_unused(const uint32_t *limit, const uint32_t *top)
+{
+    const uint32_t *p = limit;
+    while ((p < top) && (*p == PERF_STACK_FILL)) {
+        p++;
+    }
+    return (uint32_t)((const uint8_t *)p - (const uint8_t *)limit);
+}
+
+#endif /* SPDM_PERF_H */
