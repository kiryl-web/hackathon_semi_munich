+#if defined(MCUBOOT_HEADER_SIZE) && (MCUBOOT_HEADER_SIZE > 0)
+/******************************************************************************
+ * Hackathon Task 4: REAL measurements when the responder runs behind the Edge
+ * Protect Bootloader (TARGET=APP_KIT_PSC3M6_EVAL_EPBL, MCUBOOT_HEADER_SIZE=0x400).
+ *
+ *  Block 1 (digest): the boot stage that authenticated this image -- the EPBL
+ *          flash area 0x32000000..slot start. (Reported in the DMTF
+ *          "immutable ROM" slot: it is the first OEM boot stage.)
+ *  Block 2 (digest): the running MCUboot image exactly as EPBL verified it:
+ *          header + S + NS payload + protected TLVs (the bytes covered by the
+ *          ML-DSA-87 signature's SHA-512 image hash). A verifier recomputes the
+ *          same digest from the signed release file.
+ *  Block 3 (raw)   : secure version number = MCUboot header version
+ *          (major << 24 | minor << 16 | revision) -- the value EPBL's
+ *          downgrade prevention compares on update.
+ *  Block 4 (raw)   : informational string with the version.
+ * The image is executed in place and immutable at run time, so the digests
+ * are computed once per hash algorithm and cached.
+ *****************************************************************************/
+#include "cymem_CM33_0_S.h"
+
+#define MEAS_SLOT_OFFSET    (CYMEM_CM33_0_S_m33_nvm_OFFSET)          /* 0x1B000 */
+#define MEAS_SLOT_SIZE      (CYMEM_CM33_0_S_m33_nvm_SIZE + CYMEM_CM33_0_S_m33ns_nvm_SIZE)
+#define MEAS_NS_OFFSET      (CYMEM_CM33_0_S_m33ns_nvm_OFFSET)        /* 0x34000 */
+#define MEAS_FLASH_S_BASE   (CYMEM_CM33_0_S_m33_nvm_S_START - CYMEM_CM33_0_S_m33_nvm_OFFSET)
+#define MEAS_FLASH_NS_BASE  (CYMEM_CM33_0_S_m33ns_nvm_START - CYMEM_CM33_0_S_m33ns_nvm_OFFSET)
+#define MCUBOOT_MAGIC       (0x96F3B83DUL)
