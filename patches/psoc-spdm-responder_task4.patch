+/* Flash read pointer for a flash offset: secure-mapped blocks through the
+ * secure S-bus alias, blocks the MPC marks non-secure (the NS code area and the
+ * TLVs behind it) through the non-secure alias. */
+static const uint8_t *meas_flash(uint32_t offset)
+{
+    return (const uint8_t *)(uintptr_t)((offset >= MEAS_NS_OFFSET) ?
+        (MEAS_FLASH_NS_BASE + offset) : (MEAS_FLASH_S_BASE + offset));
+}
+
+static psa_status_t meas_hash_flash(psa_hash_operation_t *op, uint32_t off, uint32_t len)
+{
+    /* CPU-copy through a secure SRAM bounce buffer, so a hash engine never
+     * sees a non-secure-alias source address. */
+    static uint8_t buf[256];
+    while (len > 0U) {
+        uint32_t n = (len > sizeof(buf)) ? (uint32_t)sizeof(buf) : len;
+        /* never let one chunk straddle the S/NS alias boundary */
+        if ((off < MEAS_NS_OFFSET) && (off + n > MEAS_NS_OFFSET)) {
+            n = MEAS_NS_OFFSET - off;
+        }
+        const uint8_t *src = meas_flash(off);
+        for (uint32_t i = 0; i < n; i++) { buf[i] = src[i]; }
+        psa_status_t st = psa_hash_update(op, buf, n);
+        if (st != PSA_SUCCESS) {
+            return st;
+        }
+        off += n;
+        len -= n;
+    }
+    return PSA_SUCCESS;
