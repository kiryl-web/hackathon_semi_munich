diff --git a/proj_cm33_ns/spdm/spdm_fault_inject.h b/proj_cm33_ns/spdm/spdm_fault_inject.h
new file mode 100644
index 0000000..b5ca766
--- /dev/null
+++ b/proj_cm33_ns/spdm/spdm_fault_inject.h
@@ -0,0 +1,50 @@
+/******************************************************************************
+ * File Name: spdm_fault_inject.h
+ *
+ * Description: Hackathon negative-test hooks. A build with
+ *              SPDM_FAULT_INJECT=<mode> deliberately corrupts ONE piece of
+ *              responder output so the host requester's rejection can be
+ *              demonstrated (modified certificate, invalid signature, modified
+ *              transcript / handshake message, tampered application data).
+ *
+ *              SPDM_FAULT_INJECT=0 (default) compiles every hook out; the
+ *              production image is unchanged. Never ship a build with != 0.
+ *
+ *              Select on the make command line, e.g.
+ *                  make build SPDM_PROFILE=P4 SPDM_FAULT_INJECT=2
+ *****************************************************************************/
+#ifndef SPDM_FAULT_INJECT_H
+#define SPDM_FAULT_INJECT_H
+
+#include "log/log.h"
+
+#ifndef SPDM_FAULT_INJECT
+#define SPDM_FAULT_INJECT 0
+#endif
+
+/* Modified on-device certificate: one character of the leaf subject CN in the
+ * served SPDM cert_chain is changed ("PSC3 DEV 01" -> "PSC3 DEV 0X"). The CA
+ * signature over the leaf no longer verifies. */
+#define SPDM_FI_CERT          1
+/* Invalid signature: one byte of every responder signature (CHALLENGE_AUTH,
+ * MEASUREMENTS, KEY_EXCHANGE_RSP) is flipped after the SPE signed it. */
+#define SPDM_FI_SIG           2
+/* Modified transcript: the responder signs a transcript hash with one bit
+ * flipped, i.e. a well-formed signature over a transcript the requester did
+ * not see. */
+#define SPDM_FI_TRANSCRIPT    3
+/* Modified key-exchange data: the ML-KEM-1024 ciphertext is corrupted BEFORE
+ * KEY_EXCHANGE_RSP is signed. The signature verifies, but the requester's
+ * decapsulation yields a different (implicitly rejected) shared secret, so
+ * key confirmation (ResponderVerifyData / FINISH) must fail. */
+#define SPDM_FI_KEM_CT        4
+/* Man-in-the-middle on the wire: the AEAD tag (last byte) of the 1st secured
+ * response after the handshake (FINISH_RSP) is flipped. */
+#define SPDM_FI_WIRE_FINISH   5
+/* Man-in-the-middle on the wire: the AEAD tag of the 2nd secured response
+ * (the encrypted application-data echo) is flipped. */
+#define SPDM_FI_WIRE_APP      6
+
+#define SPDM_FI_ACTIVE(mode)  (SPDM_FAULT_INJECT == (mode))
+
+#endif /* SPDM_FAULT_INJECT_H */
diff --git a/proj_cm33_ns/spdm/spdm_perf_ns.h b/proj_cm33_ns/spdm/spdm_perf_ns.h
new file mode 100644
index 0000000..108973e
--- /dev/null
+++ b/proj_cm33_ns/spdm/spdm_perf_ns.h
@@ -0,0 +1,38 @@
+/******************************************************************************
+ * File Name:   spdm_perf_ns.h
+ *
+ * Description: Hackathon measurement counters for the NS world. The crypto
+ *              glue accumulates cycles here; the router prints one [PERF]
+ *              line per SPDM transfer (after the timed work is done, so UART
+ *              output is never inside a measured interval).
+ *****************************************************************************/
+#ifndef SPDM_PERF_NS_H
+#define SPDM_PERF_NS_H
+
+#include <stdint.h>
+#include "spdm_perf.h"
+
+typedef struct {
+    /* per-transfer crypto cycles (cleared after each [PERF] line) */
+    uint32_t sign_cyc;        /* device-identity sign (ECDSA or ML-DSA), SPE */
+    uint32_t kex_gen_cyc;     /* ECDHE ephemeral key generation, SPE         */
+    uint32_t kex_ss_cyc;      /* ECDHE shared-secret computation, SPE        */
+    uint32_t kem_encap_cyc;   /* ML-KEM encapsulation, SPE                   */
+} spdm_perf_crypto_t;
+
+extern spdm_perf_crypto_t g_spdm_perf;
+
+/* NS cycle clock: DWT->CYCCNT reads as 0 from the NS world on this device, so
+ * the NS SysTick (24-bit, core clock) plus a wrap counter in SysTick_Handler
+ * forms a 32-bit free-running cycle counter. Intervals < 2^32 cycles (~23 s at
+ * 180 MHz) are measured correctly with unsigned subtraction. */
+void     perf_ns_timer_init(void);
+uint32_t perf_ns_cyc(void);
+
+#define PERF_ACC(field, expr) do {                        \
+        uint32_t perf_t0_ = perf_ns_cyc();                \
+        expr;                                             \
+        g_spdm_perf.field += perf_ns_cyc() - perf_t0_;    \
+    } while (0)
+
+#endif /* SPDM_PERF_NS_H */
diff --git a/proj_cm33_s/nsc/nsc_perf.c b/proj_cm33_s/nsc/nsc_perf.c
new file mode 100644
index 0000000..b281939
--- /dev/null
+++ b/proj_cm33_s/nsc/nsc_perf.c
@@ -0,0 +1,35 @@
+/******************************************************************************
+ * File Name:   nsc_perf.c
+ *
+ * Description: Hackathon measurement veneer (see shared/nsc_perf.h).
+ *****************************************************************************/
+#include <arm_cmse.h>
+#include "nsc_perf.h"
+#include "spdm_perf.h"
+
+extern unsigned int spdm_heap_peak_bytes;   /* core/spdm_heap.c */
+extern char __HeapBase;
+extern char __HeapLimit;
+extern uint32_t __StackLimit;
+extern uint32_t __StackTop;
+
+__attribute__((cmse_nonsecure_entry))
+uint32_t nsc_perf_get(uint32_t which)
+{
+    uint32_t stack_size = (uint32_t)((uint8_t *)&__StackTop - (uint8_t *)&__StackLimit);
+
+    switch (which) {
+        case NSC_PERF_S_HEAP_PEAK:
+            return (uint32_t)spdm_heap_peak_bytes;
+        case NSC_PERF_S_HEAP_SIZE:
+            return (uint32_t)(&__HeapLimit - &__HeapBase);
+        case NSC_PERF_S_STACK_PEAK:
+            return stack_size - perf_stack_unused(&__StackLimit, &__StackTop);
+        case NSC_PERF_S_STACK_SIZE:
+            return stack_size;
+        default:
+            return 0U;
+    }
+}
+
+/* [] END OF FILE */
