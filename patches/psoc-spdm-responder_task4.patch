+static char s_version_info[48] = "PSC3M6-SPDM-P4 (no MCUboot header)";
+static uint32_t s_cached_alg = 0U;
+
+static char *put_u(char *p, uint32_t v)
+{
+    char tmp[10];
+    int n = 0;
+    do { tmp[n++] = (char)('0' + (v % 10U)); v /= 10U; } while ((v != 0U) && (n < 10));
+    while (n > 0) { *p++ = tmp[--n]; }
+    return p;
+}
+
+/* Parse the MCUboot header of the running image; returns the number of bytes
+ * EPBL hashed (header + image + protected TLVs) or 0 if the header is invalid. */
+static uint32_t meas_image_info(void)
+{
+    const uint8_t *h = meas_flash(MEAS_SLOT_OFFSET);
+    if (rd32(h) != MCUBOOT_MAGIC) {
+        return 0U;
+    }
+    uint32_t hdr = rd16(h + 8), prot = rd16(h + 10), img = rd32(h + 12);
+    uint32_t total = hdr + img + prot;
+    if ((hdr != MCUBOOT_HEADER_SIZE) || (total > MEAS_SLOT_SIZE)) {
+        return 0U;
+    }
+    uint32_t maj = h[20], min = h[21], rev = rd16(h + 22), bn = rd32(h + 24);
