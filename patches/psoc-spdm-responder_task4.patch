@@ -167,6 +304,8 @@ psa_status_t spdm_meas_collect(uint32_t measurement_hash_algo,
     if ((st != PSA_SUCCESS) || (produced != digest_size)) {
         return (st == PSA_SUCCESS) ? PSA_ERROR_GENERIC_ERROR : st;
