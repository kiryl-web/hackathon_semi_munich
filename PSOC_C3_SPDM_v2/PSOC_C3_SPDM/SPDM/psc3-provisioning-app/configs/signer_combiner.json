{
    "schema-version": 1.0,
    "content": [
        {
            "name": "hex-relocate",
            "description": "Relocates Main CM33 Secure image to S-bus address space",
            "enabled": true,
            "commands": [
                {
                    "command": "hex-relocate",
                    "inputs": [
                        {
                            "file": "../build/project_hex/proj_cm33_s.hex",
                            "regions": [
                                {
                                    "start": "{{ CYMEM_CM33_0_S_m33_nvm_C_S_START }}",
                                    "size": "{{ CYMEM_CM33_0_S_m33_nvm_SIZE }}",
                                    "dest": "{{ CYMEM_CM33_0_S_m33_nvm_S_START }}"
                                }
                            ]
                        }
                    ],
                    "outputs": [
                        {
                            "file": "../build/project_hex/proj_cm33_s_shifted.hex"
                        }
                    ],
                    "extra_config" : [
                        {
                            "project" : "proj_cm33_s",
                            "debug_config_name" : "proj_cm33_s",
                            "default" : false,
                            "build_dependency" : "project"
                        }
                    ]
                }
            ]
        },
        {
            "name": "hex-relocate",
            "description": "Relocates Main CM33 Non-Secure image to S-bus address space",
            "enabled": true,
            "commands": [
                {
                    "command": "hex-relocate",
                    "inputs": [
                        {
                            "file": "../build/project_hex/proj_cm33_ns.hex",
                            "regions": [
                                {
                                    "start": "{{ CYMEM_CM33_0_S_m33ns_nvm_C_START }}",
                                    "size": "{{ CYMEM_CM33_0_S_m33ns_nvm_SIZE }}",
                                    "dest": "{{ CYMEM_CM33_0_S_m33ns_nvm_START }}"
                                }
                            ]
                        }
                    ],
                    "outputs": [
                        {
                            "file": "../build/project_hex/proj_cm33_ns_shifted.hex"
                        }
                    ],
                    "extra_config" : [
                        {
                            "project" : "proj_cm33_ns",
                            "debug_config_name" : "proj_cm33_ns",
                            "default" : false,
                            "build_dependency" : "project"
                        }
                    ]
                }
            ]
        },
        {
            "name": "merge",
            "description": "Merges two or more hex/bin files into a single file",
            "enabled": true,
            "commands": [
                {
                    "command": "merge",
                    "inputs": [
                        {
                            "description": "Main CM33 Secure application",
                            "file": "../build/project_hex/proj_cm33_s_shifted.hex"
                        },
                        {
                            "description": "Main CM33 Non Secure application",
                            "file": "../build/project_hex/proj_cm33_ns_shifted.hex"
                        }
                    ],
                    "outputs": [
                        {
                            "description": "CM33 Secure + CM33 Non-Secure + PPCA 0 + PPCA 1",
                            "file": "../build/app_combined.hex",
                            "format": "ihex",
                            "overlap": "ignore"
                        }
                    ]
                }
            ]
        }
    ]
}
